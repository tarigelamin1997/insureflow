# =============================================================================
# InsureFlow — environment contract.
# Copy to .env (gitignored) before running:  cp .env.example .env
# Every ${VAR} referenced in docker-compose.yml MUST be documented here, or
# `docker compose config` fails (the VG4 completeness check).
# Later phases extend this file as they add services.
# =============================================================================

# -----------------------------------------------------------------------------
# Canary (Phase 01 reference fixture)
# -----------------------------------------------------------------------------
# Digest-pinned image — NOT a floating tag. This is the single source of the digest:
# docker-compose.yml reads it as ${CANARY_IMAGE}; Terraform reads the same value via
# TF_VAR_canary_image (see 01-infrastructure/terraform). The VG4 note above covers ${VAR}
# resolution for docker-compose only — before `terraform apply`, also export it:
#   export TF_VAR_canary_image=$(grep '^CANARY_IMAGE=' .env | cut -d= -f2)
# Re-pin with:
#   docker buildx imagetools inspect nginx:alpine --format '{{.Manifest.Digest}}'
# (pin the multi-arch index digest so it resolves on amd64 and arm64).
CANARY_IMAGE=nginx@sha256:8b1e78743a03dbb2c95171cc58639fef29abc8816598e27fb910ed2e621e589a

# Host port the canary's HTTP endpoint is published on (container listens on 80).
CANARY_HOST_PORT=8080

# -----------------------------------------------------------------------------
# Source Systems (Phase 02) — PMS / CMS / PFS PostgreSQL 16 instances
# -----------------------------------------------------------------------------
# Single digest-pinned image shared by all three source DBs (ADR-001). This is the
# ONLY place the digest lives: docker-compose.yml reads it as ${POSTGRES_IMAGE};
# Terraform (02-source-systems/terraform) reads the SAME value via TF_VAR_postgres_image.
# Before `terraform apply`, export it:
#   export TF_VAR_postgres_image=$(grep '^POSTGRES_IMAGE=' .env | cut -d= -f2)
# Re-pin with (pin the multi-arch INDEX digest so it resolves on amd64 and arm64):
#   docker buildx imagetools inspect postgres:16 --format '{{.Manifest.Digest}}'
POSTGRES_IMAGE=postgres@sha256:081f1bc7bd5e143dbb6e487b710bbc27712cdcfaced4c071b8e47349aa1b4171

# Dedicated logical-replication role (cluster-level REPLICATION attribute), created by
# 02-source-systems/schema/init/00-replication-role.sh on first init of every source DB.
# Phase 03 Debezium logs in as this role. Least-privilege: LOGIN + REPLICATION, not superuser.
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator_pw_change_me

# Host the source instances are reachable on FROM THE HOST (seed loader + contract tests
# connect over the published ports below). localhost for a local `docker compose up`; override
# per system only if the stack runs on a remote/named Docker host. Compose itself uses the
# service-name DNS (postgres-pms/cms/pfs) on the internal network and ignores these.
POSTGRES_PMS_HOST=localhost
POSTGRES_CMS_HOST=localhost
POSTGRES_PFS_HOST=localhost

# PMS — Policy Management System (source of policyholders, policies, agents, products…)
POSTGRES_PMS_USER=pms
POSTGRES_PMS_PASSWORD=pms_pw_change_me
POSTGRES_PMS_DB=pms
POSTGRES_PMS_HOST_PORT=5432

# CMS — Claims Management System (source of claims, assessments, settlements…)
POSTGRES_CMS_USER=cms
POSTGRES_CMS_PASSWORD=cms_pw_change_me
POSTGRES_CMS_DB=cms
POSTGRES_CMS_HOST_PORT=5433

# PFS — Premium & Finance System (source of premium_transactions, reinsurance, IFRS 17…)
POSTGRES_PFS_USER=pfs
POSTGRES_PFS_PASSWORD=pfs_pw_change_me
POSTGRES_PFS_DB=pfs
POSTGRES_PFS_HOST_PORT=5434
